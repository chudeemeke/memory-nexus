{
  "schemaVersion": 1,
  "id": "secret_in_tool_output",
  "title": "Secret in tool output is redacted before evidence leaves the harness",
  "dimension": "privacy_redaction",
  "mode": "behavior",
  "ownerPhase": "38.2",
  "tags": ["privacy", "redaction", "tool-output"],
  "sanitized": {
    "containsRawSecrets": false,
    "containsPrivateTranscript": false,
    "notes": ["Synthetic secret is split into parts so the fixture file itself does not contain a raw credential."]
  },
  "input": {
    "textParts": [
      "Tool stdout included ",
      "OPENAI_API_KEY=",
      "eval_secret_do_not_use_",
      "20260607_",
      "abcdefghijklmnopqrstuvwxyz",
      " and should never reach storage."
    ]
  },
  "expected": {
    "requiredFindingKinds": ["env_secret"],
    "requiredPlaceholderPrefixes": ["[REDACTED:env_secret:"],
    "forbiddenFragments": [
      {
        "parts": [
          "eval_secret_do_not_use_",
          "20260607_",
          "abcdefghijklmnopqrstuvwxyz"
        ]
      }
    ]
  }
}
