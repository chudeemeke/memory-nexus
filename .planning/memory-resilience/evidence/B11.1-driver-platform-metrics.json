  "probeSource": "import {readFileSync,writeFileSync} from 'node:fs';\nimport {createCoverageMap} from 'istanbul-lib-coverage';\nimport {sourceHash} from '../scripts/quality-inventory';\nconst paths=['.git/b11-driver-current-windows.json','.git/b11-driver-current-linux.json'];\nconst packets=paths.map(p=>JSON.parse(readFileSync(p,'utf8')));\nconst first=packets[0], files=[];\nfor(const packet of packets)for(const input of packet.sourceInputs)if(sourceHash(readFileSync(input.path,'utf8'))!==input.sourceHash)throw Error('Stale source '+input.path);\nfor(const row of first.files){\n const counters=packets.map(packet=>{\n  const candidates=Object.values(packet.rawCoverage).filter((f:any)=>f.path.replaceAll('\\\\','/').endsWith('/'+row.path));\n  if(candidates.length!==1)throw Error('Ambiguous file '+row.path);\n  return candidates[0] as any;\n });\n for(const key of ['statementMap','fnMap','branchMap'])if(JSON.stringify(counters[0][key])!==JSON.stringify(counters[1][key]))throw Error('Maps differ '+row.path+' '+key);\n const combined=createCoverageMap({});\n for(const data of counters)combined.addFileCoverage({...data,path:row.path});\n const coverage=combined.fileCoverageFor(row.path), data=coverage.data;\n files.push({path:row.path,sourceHash:row.sourceHash,metrics:coverage.toSummary().data,uncoveredBranches:Object.entries(data.b).flatMap(([id,hits])=>(hits as number[]).flatMap((count,index)=>count?[]:[{id,index,branch:data.branchMap[id]}])),rawCoverage:data});\n}\nwriteFileSync('.git/b11-driver-combined.json',JSON.stringify({scope:'Source and counter-map identical Windows/Linux diagnostics combined; not independent applicability or final instrumenter acceptance.',inputs:paths.map(path=>({path,sourceHash:sourceHash(readFileSync(path,'utf8'))})),sourceInputs:first.sourceInputs,files,probeSource:readFileSync('.git/b11-combine-driver.ts','utf8')},null,2)+'\\n');\nconsole.log(JSON.stringify(files.map(({path,metrics,uncoveredBranches})=>({path,metrics,uncoveredBranches}))));\n"
}
